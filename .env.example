# คัดลอกเป็น .env.local แล้วใส่ค่า (ห้าม commit .env.local)
# ไม่ใส่ key เลย → แอปทำงานในโหมดออฟไลน์ (ชี้หมุด + การ์ดข้อมูลจริง แต่ไม่เรียบเรียงคำตอบ)
# ใส่เฉพาะ key ที่มี ตัวที่ไม่มี key จะถูกข้ามไปเอง

# MiniMax ผ่าน gateway ของ SIT (key จากอาจารย์) — ตัวหลัก
# gateway เปิดแบบ Anthropic API (/v1/messages) มีโมเดล minimax-m3, minimax-m2.7, minimax-m3.1-flash
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://nrrai2-model.sit.kmutt.ac.th/api/v1

# Gemini (ฟรี) — สำรอง — สร้าง key ที่ https://aistudio.google.com/apikey
# หมายเหตุ: เวอร์ชันฟรีอาจนำข้อความไปใช้พัฒนาโมเดล แอปจึงตัดข้อมูลส่วนตัวออกก่อนส่ง
GOOGLE_GENERATIVE_AI_API_KEY=

# Typhoon (ฟรี, โมเดลภาษาไทย) — สำรองชั้นสุดท้าย — https://opentyphoon.ai
TYPHOON_API_KEY=

# ลำดับโมเดลที่จะลอง (ตัวแรกล้มหรือไม่เริ่มตอบใน 8 วิ → ตัวถัดไป → สุดท้ายโหมดออฟไลน์)
# CHAT_MODELS=minimax:minimax-m3,google:gemini-3.5-flash-lite,google:gemini-3.5-flash,typhoon:typhoon-v2.5-30b-a3b-instruct

# ── Login + ประวัติแชทบน server (ไม่ตั้งก็ใช้ได้: ไม่มีปุ่ม Google และประวัติอยู่ในเครื่อง) ──
# ฐานข้อมูล Neon Postgres (ฟรี) — ไม่ตั้งตอน dev จะใช้ Postgres ในเครื่อง (PGlite) ที่ .data/pglite
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Better Auth — production ต้องตั้ง secret สุ่มยาว ๆ (เช่น `openssl rand -base64 32`) และ URL ของเว็บ
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (และ https://<โดเมนจริง>/api/auth/callback/google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# รหัสผ่านของ "ล็อกอินทดสอบ" (tester@tangmod.test) ใช้ได้เฉพาะ dev — production ปิดปุ่มนี้เสมอ
# DEV_TEST_PASSWORD=tangmod-dev-only-password

# จำนวนคำถามต่อนาทีต่อ IP
# CHAT_RATE_LIMIT_PER_MIN=12
